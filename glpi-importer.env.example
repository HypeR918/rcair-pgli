# Copy these variables to the environment on the GLPI Docker host.

# Listen on 127.0.0.1 if the bot runs on the same server.
# Use 0.0.0.0 only if the bot connects from another machine, and restrict the port with firewall rules.
IMPORTER_HOST=127.0.0.1
IMPORTER_PORT=3100

# Must match GLPI_IMPORT_SECRET in the bot environment.
GLPI_IMPORT_SECRET=change_me_to_a_long_random_secret

# Docker / GLPI container settings.
DOCKER_BIN=docker
GLPI_DOCKER_CONTAINER=glpi
GLPI_CONTAINER_USER=www-data
GLPI_CONSOLE_PATH=/var/www/html/bin/console

# LDAP filter used by glpi:ldap:synchronize_users -f.
# Usually mail is best because the bot receives email from the user.
GLPI_LDAP_FILTER_ATTRIBUTE=mail

# CLI command timeout.
GLPI_IMPORT_COMMAND_TIMEOUT_MS=120000
